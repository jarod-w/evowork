+/// EvoWork P6: the approval reason prefix EvoWork's approval card recognizes.
+/// Keep in sync with `services/policy/src/execpolicy.ts` (`OVERWRITE_REASON_PREFIX`).
+const OVERWRITE_REASON_PREFIX: &str = "overwrites an existing file: ";
+
+/// EvoWork P6: turn "run without asking" into "ask" when the command truncates
+/// (`>`, `>|`, `&>`) a file that already exists. Leaves `never`, explicit
+/// execpolicy allow rules (`bypass_sandbox`) and every other decision alone.
+fn require_approval_before_overwrite(
+    requirement: crate::tools::sandboxing::ExecApprovalRequirement,
+    command: &[String],
+    cwd: &PathUri,
+    approval_policy: codex_protocol::protocol::AskForApproval,
+) -> crate::tools::sandboxing::ExecApprovalRequirement {
+    use crate::tools::sandboxing::ExecApprovalRequirement;
+    use codex_protocol::protocol::AskForApproval;
+
+    let may_prompt = match approval_policy {
+        AskForApproval::Never => false,
+        AskForApproval::OnRequest | AskForApproval::UnlessTrusted => true,
+        AskForApproval::Granular(config) => config.allows_sandbox_approval(),
+    };
+    let runs_unasked = matches!(
+        requirement,
+        ExecApprovalRequirement::Skip {
+            bypass_sandbox: false,
+            ..
+        }
+    );
+    if !may_prompt || !runs_unasked {
+        return requirement;
+    }
+    let Ok(cwd) = cwd.to_abs_path() else {
+        return requirement;
+    };
+    let existing: Vec<String> =
+        codex_shell_command::bash::parse_shell_lc_truncating_redirect_targets(command)
+            .unwrap_or_default()
+            .into_iter()
+            .filter(|target| cwd.as_path().join(target).is_file())
+            .collect();
+    if existing.is_empty() {
+        return requirement;
+    }
+    ExecApprovalRequirement::NeedsApproval {
+        reason: Some(format!("{OVERWRITE_REASON_PREFIX}{}", existing.join(", "))),
+        proposed_execpolicy_amendment: None,
+    }
+}
