+/// EvoWork P6: literal destinations of truncating output redirects (`>`, `>|`,
+/// `&>`) in a `bash -lc` / `zsh -lc` script. Appends (`>>`), descriptor
+/// duplication (`>&2`) and dynamic destinations are ignored. Callers use this to
+/// ask before a command overwrites a file that already exists.
+pub fn parse_shell_lc_truncating_redirect_targets(command: &[String]) -> Option<Vec<String>> {
+    let (_, script) = extract_bash_command(command)?;
+    let tree = try_parse_shell(script)?;
+    let root = tree.root_node();
+    if root.has_error() {
+        return None;
+    }
+
+    let mut targets = Vec::new();
+    let mut stack = vec![root];
+    while let Some(node) = stack.pop() {
+        if node.kind() == "file_redirect" {
+            let mut cursor = node.walk();
+            let truncates = node
+                .children(&mut cursor)
+                .any(|child| !child.is_named() && matches!(child.kind(), ">" | ">|" | "&>"));
+            if truncates
+                && let Some(destination) = node.child_by_field_name("destination")
+                && let Some(target) = parse_literal_shell_word(destination, script)
+            {
+                targets.push(target);
+            }
+        }
+
+        let mut cursor = node.walk();
+        for child in node.named_children(&mut cursor) {
+            stack.push(child);
+        }
+    }
+
+    Some(targets)
+}
