{
  "description": "EvoWork 的策略包（K3 的第三个扩展点）。内核的 hooks 事件契约见 ../../../codex/codex-rs/hooks/src/events/。每个 handler 从 stdin 读一行 JSON，向 stdout 写一行 JSON。 形状是内核的 HooksFile：事件必须包在 `hooks` 里 —— 放在顶层会被解析成空集并被**静默丢掉**（2026-09-28 实测）。桌面宿主启动时把它展开成 $CODEX_HOME/hooks.json（绝对路径 + Electron 充当 node）。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/pre-tool-use.mjs"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/permission-request.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/post-tool-use.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/session-end.mjs"
          }
        ]
      }
    ]
  }
}
